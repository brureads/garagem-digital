rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId}/favoritos/{favoritoId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['marca', 'modelo', 'criadoEm'])
        && request.resource.data.marca is string
        && request.resource.data.modelo is string
        && request.resource.data.marca.size() <= 80
        && request.resource.data.modelo.size() <= 120
        && request.resource.data.criadoEm is timestamp;
    }
  }
}
